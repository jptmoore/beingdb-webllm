{
  "name": "beingdb-webllm",
  "version": "0.0.1",
  "private": true,
  "description": "A browser chatbot over BeingDB facts: a local WebLLM model writes the query, BeingDB WASM checks and answers it. Includes a benchmark for improving it.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "link": "node scripts/link.mjs",
    "serve": "node scripts/serve.mjs",
    "build:site": "node scripts/build-site.mjs",
    "check-eval": "node eval/check-references.mjs",
    "test": "node --test test/*.test.mjs eval/test/*.test.mjs",
    "benchmark": "node eval/scripts/benchmark.mjs",
    "benchmark:matrix": "node eval/scripts/benchmark-matrix.mjs",
    "models": "node eval/scripts/models.mjs",
    "compare": "node eval/scripts/compare.mjs",
    "export-results": "node eval/scripts/export-results.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
